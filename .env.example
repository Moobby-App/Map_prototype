# Apple Developer team identifier used to sign MapKit JS tokens.
TEAM_ID=YOUR_TEAM_ID
# Apple MapKit key identifier that matches your private key.
KEY_ID=YOUR_KEY_ID
# Path to the matching .p8 file, relative to the repository root or absolute.
MAPKIT_PRIVATE_KEY_PATH=keys/AuthKey.p8
# Must match the browser origin used to open the app.
MAPKIT_ORIGIN=http://localhost:8000
# Optional installed Chrome executable path for the KRL live poller.
# Defaults to /Applications/Google Chrome.app/Contents/MacOS/Google Chrome.
CHROME_PATH=
